* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #0a0a0a;
  height: 100vh;
  margin: 0;
  overflow: hidden;
}
/* ==== App Layout ==== */
.app {
  display: flex;
  width: 900px;
  max-width: 100%;
  height: 100vh;
  max-height: 800px;
  margin: 0 auto;
  background: #111b21;
  box-shadow: 0 0 40px rgba(0,0,0,0.5);
  border-radius: 16px;
  overflow: hidden;
}

/* ==== Sidebar ==== */
.sidebar {
  width: 240px;
  min-width: 240px;
  max-width: 240px;
  background: #111b21;
  border-right: 1px solid #2a3942;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

/* ==== Chat Area ==== */
.container {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: #111b21;
  height: 100%;
  overflow: hidden;
}
.sidebar-header {
  padding: 16px;
  background: #202c33;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #2a3942;
}

.sidebar-header h3 {
  color: white;
  font-size: 0.95rem;
  font-weight: 500;
}

.badge {
  background: #00a884;
  color: white;
  font-size: 0.75rem;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 600;
}

.tabs {
  display: flex;
  border-bottom: 1px solid #2a3942;
}

.tab {
  flex: 1;
  padding: 10px;
  background: none;
  border: none;
  color: #8696a0;
  cursor: pointer;
  font-size: 0.85rem;
  border-bottom: 2px solid transparent;
}

.tab.active {
  color: #00a884;
  border-bottom-color: #00a884;
}

.tab:hover { background: #202c33; }

.online-list {
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.online-user {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.2s;
  margin-bottom: 4px;
}

.online-user:hover { background: #202c33; }
.online-user.active { background: #005c4b; }

.online-user .dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: #00a884;
  flex-shrink: 0;
}

.online-user .avatar {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: #00a884;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.online-user .name {
  color: #e9edef;
  font-size: 0.9rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.online-user .name.me { color: #8696a0; font-style: italic; }

/* ==== Room List ==== */
.room-item {
  padding: 10px 12px;
  border-radius: 8px;
  cursor: pointer;
  margin-bottom: 4px;
  background: #202c33;
  transition: background 0.2s;
}

.room-item:hover { background: #2a3942; }
.room-item.active { background: #005c4b; }

.room-item .room-name {
  color: #e9edef;
  font-size: 0.9rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 6px;
}

.room-item .room-meta {
  color: #8696a0;
  font-size: 0.75rem;
  margin-top: 4px;
}

/* ==== Container (Chat Area) ==== */
header {
  background: #202c33;
  color: white;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid #2a3942;
  flex-shrink: 0;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.avatar-header {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: #00a884;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  flex-shrink: 0;
}

header h1 { font-size: 1rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#status { font-size: 0.75rem; color: #8696a0; display: block; }

.back-btn {
  background: none;
  border: 1px solid #00a884;
  color: #00a884;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.back-btn.hidden { display: none; }
.back-btn:hover { background: #00a884; color: white; }

.sidebar-toggle {
  background: none;
  border: none;
  color: #8696a0;
  font-size: 1.2rem;
  cursor: pointer;
  padding: 4px 8px;
  display: none;
}

#messages {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: #0b141a;
}

.message {
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 75%;
  padding: 8px 12px;
  border-radius: 8px;
  word-wrap: break-word;
  animation: slideIn 0.2s ease;
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.message.own {
  align-self: flex-end;
  background: #005c4b;
  color: white;
  border-top-right-radius: 2px;
}

.message.other {
  align-self: flex-start;
  background: #202c33;
  color: #e9edef;
  border-top-left-radius: 2px;
}

.message .meta {
  font-size: 0.7rem;
  color: #8696a0;
  display: flex;
  gap: 6px;
  align-items: center;
}

.message.own .meta { color: #a8d5c5; }
.message .meta .name { font-weight: 600; color: #00a884; cursor: pointer; }
.message.own .meta .name { color: #06cf9c; }
.message .meta .name:hover { text-decoration: underline; }

.message img {
  max-width: 100%;
  border-radius: 6px;
  margin-top: 4px;
  cursor: pointer;
}

.system {
  align-self: center;
  font-size: 0.75rem;
  color: #8696a0;
  padding: 4px 12px;
  background: #182229;
  border-radius: 8px;
}

form {
  display: flex;
  gap: 8px;
  padding: 8px 12px;
  background: #202c33;
  align-items: center;
  flex-shrink: 0;
}

.attach-btn {
  font-size: 1.5rem;
  cursor: pointer;
  padding: 8px;
  color: #8696a0;
  transition: color 0.2s;
  user-select: none;
}

.attach-btn:hover { color: #00a884; }

#input {
  flex: 1;
  min-width: 0;
  border: none;
  border-radius: 20px;
  padding: 10px 16px;
  font-size: 1rem;
  background: #2a3942;
  color: white;
  outline: none;
}

#input::placeholder { color: #8696a0; }

form button {
  background: #00a884;
  color: white;
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

form button:hover:not(:disabled) { background: #06cf9c; }
form button:disabled { opacity: 0.5; cursor: not-allowed; }

/* ==== Modal ==== */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 20px;
}

.modal.hidden { display: none; }

.modal-content {
  background: #202c33;
  border-radius: 16px;
  padding: 32px;
  max-width: 400px;
  width: 100%;
  text-align: center;
  color: white;
}

.modal-content h2 { margin-bottom: 8px; }
.modal-content p { color: #8696a0; margin-bottom: 20px; font-size: 0.9rem; }

.modal-content input {
  width: 100%;
  border: 1px solid #2a3942;
  border-radius: 12px;
  padding: 12px 16px;
  font-size: 1rem;
  background: #2a3942;
  color: white;
  outline: none;
  margin-bottom: 12px;
}

.modal-content input:focus { border-color: #00a884; }

.modal-content button {
  width: 100%;
  background: #00a884;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 12px;
  font-size: 1rem;
  cursor: pointer;
  font-weight: 600;
  margin-top: 8px;
}

.modal-content button:hover { background: #06cf9c; }

.btn-secondary {
  background: transparent !important;
  border: 1px solid #2a3942 !important;
  color: #8696a0 !important;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #8696a0;
  font-size: 0.85rem;
  margin-bottom: 16px;
  cursor: pointer;
  text-align: left;
}

.checkbox-label input { cursor: pointer; width: auto; }

.icon-btn {
  background: #00a884;
  color: white;
  border: none;
  border-radius: 50%;
  width: 28px;
  height: 28px;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-btn:hover { background: #06cf9c; }

.image-preview {
  position: fixed;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  background: #202c33;
  padding: 8px;
  border-radius: 8px;
  display: flex;
  gap: 8px;
  align-items: center;
  z-index: 50;
}

.image-preview.hidden { display: none; }
.image-preview img { max-height: 60px; border-radius: 4px; }
.image-preview button {
  background: #ff4444;
  color: white;
  border: none;
  border-radius: 50%;
  width: 24px;
  height: 24px;
  cursor: pointer;
}

.hidden { display: none !important; }

/* ==== Mobile ==== */
@media (max-width: 700px) {
  .app {
    max-width: 100%;
    max-height: 100vh;
    border-radius: 0;
  }

  .sidebar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    z-index: 20;
    transform: translateX(-100%);
    box-shadow: 4px 0 20px rgba(0,0,0,0.5);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .sidebar-toggle {
    display: block;
  }
}
